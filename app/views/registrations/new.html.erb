<%# Reached two ways: through the sign-up funnel (?type= is set → frame it as
    account creation) or via the "Sign in" shortcut / a deep link (→ "Sign in").
    A hidden :type round-trips so the framing survives a validation re-render. %>
<% signup = params[:type].present? %>
<%= content_for :body do %>
  <%= form_tag registrations_path(registration_configuration(:email, :phone)), class: 'w-full' do %>
    <%= hidden_field_tag :type, params[:type] if signup %>
    <div class="w-full flex items-center flex-col">
      <div class="flex flex-row justify-between border-b pb-3 mb-5 w-full pt-8 items-center">
        <h2 class="text-lg text-primary font-bold leading-none">
          <%# Sign-up funnel → "Create your sign-in" (not tied to a relying party);
              the returning-user / deep-link path keeps the "Sign in" framing. %>
          <% if signup %>
            <%= t 'registrations.choose.title' %>
          <% elsif relying_party&.name %>
            <%= t '.login_at_html', name: relying_party.name %>
          <% else %>
            <%= t '.login' %>
          <% end %>
        </h2>
        <a href="javascript:void(toggleDescription());" class="flex flex-row items-center space-x-1">
          <%= image_tag('logo.png', class: 'h-4') %>
          <span class=" bg-clip-text text-transparent bg-gradient-to-t from-blue-900 to-blue-500 tracking-tight text-base font-bold">
            Promise
          </span>
        </a>
      </div>
      <% if relying_party %>
        <p class="block text-primary w-full">
          <%= t '.relying_party_intro_html', name: relying_party&.name || name %>
        </p>
      <% end %>

      <% phone_initial = params[:type] == 'phone' || signup_identifier&.phone? %>
      <div class="w-full flex flex-col bg-blue-50 px-4 rounded-lg mt-6 pb-4 shadow relative">
        <div class="w-full mt-8">
          <% if @smtp_error %>
            <div class="js-when-email w-full mb-2">
              <div class="bg-red-500 text-white text-sm p-3 rounded">
                <%= t '.we_could_not_send_email_html', email: registration_configuration[:email], message: @smtp_error.message %>
              </div>
            </div>
          <% end %>

          <%= render 'shared/identifier_field',
                value: (registration_configuration[:phone].presence || @email_validator&.replacement || registration_configuration[:email]),
                invalid: (@phone_invalid || (@email_validator.present? && !@email_validator.valid?)),
                initial_type: (params[:type].presence || (signup_identifier&.phone? ? 'phone' : 'email')) %>

          <p class="text-secondary text-xs mt-1 js-when-email<%= ' hidden' if phone_initial %>">
            <%= t '.we_save_no_data_html' %>
          </p>
          <p class="text-secondary text-xs mt-1 js-when-phone<%= ' hidden' unless phone_initial %>">
            <%= t '.we_save_no_phone_html' %>
          </p>
        </div>

        <% if @email_validator && !@email_validator&.valid? %>
          <div class="js-when-email w-full mt-2">
            <%= hidden_field_tag :email_validation_shown_for, @email_validator.email %>
            <% if @email_validator.hint? %>
              <div class="bg-red-500 text-white text-sm p-3 rounded">
                <p><span><%= t '.did_you_mean_html', old_email: registration_configuration[:email], email: @email_validator.replacement %></span></p>
              </div>
            <% else %>
              <div class="bg-yellow-700 text-white text-sm p-3 rounded">
                <p><span><%= t '.your_email_seems_invalid' %></span></p>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @phone_invalid %>
          <div class="js-when-phone w-full mt-2">
            <div class="bg-yellow-700 text-white text-sm p-3 rounded">
              <p><%= t '.your_phone_seems_invalid' %></p>
            </div>
          </div>
        <% end %>

        <div class="mt-4 flex w-full flex-row justify-between items-center">
          <%# The "what should I use?" guidance now lives on the intro step; from
              the form you can step back to revisit it (or switch identifier). %>
          <%= link_to t('.back'), login_path(login_configuration.merge(type: params[:type])),
                class: 'text-sm text-secondary underline hover:text-primary' %>
          <%= button_tag type: 'submit', class: 'button primary mt-2 appearance-none', tabindex: 1, data: { 'disable-with' => t('.going_html') } do %>
            <%= t('.go_on') %><%= arrow_right %>
          <% end %>
        </div>
      </div>
      <% if relying_party %>
        <p class="mt-8 text-secondary  text-sm">
          <%= t '.no_sharing_html', relying_party_name: relying_party.name %>
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
