<%# Step 2 of the sign-up funnel: set expectations before the form with a
    "here's what's going to happen" walkthrough — pick your identifier, we send
    a confirmation code (e-mail/SMS), you set a password. The parent/child
    +-alias trick (e-mail only) lives in an expandable below. "Continue" carries
    the chosen type on to the form (?step=form), preselecting that view. %>
<% type = params[:type] == 'phone' ? 'phone' : 'email' %>
<% steps = [
     { title: t(".step1_#{type}_title"), body: t("registrations.new.what_#{type}_help") },
     { title: t('.step2_title'), body: t(".step2_#{type}") },
     { title: t('.step3_title'), body: t('.step3_body') }
   ] %>
<%# With a relying party there's a final hop: back to wherever they came from. %>
<% steps << { title: t('.step4_title', name: relying_party.name), body: t('.step4_body') } if relying_party&.name %>
<%# "…shared with %{name} or anyone else" only when there's a relying party. %>
<% privacy = relying_party&.name \
     ? t(".privacy_#{type}_rp_html", name: relying_party.name) \
     : t(".privacy_#{type}_html") %>
<%= content_for :body do %>
  <div class="w-full flex items-center flex-col">
    <div class="flex flex-row justify-between border-b pb-3 mb-5 w-full pt-8 items-center">
      <h2 class="text-lg text-primary font-bold leading-none">
        <%= t 'registrations.choose.title' %>
      </h2>
      <a href="javascript:void(toggleDescription());" class="flex flex-row items-center space-x-1">
        <%= image_tag('logo.png', class: 'h-4') %>
        <span class="bg-clip-text text-transparent bg-gradient-to-t from-blue-900 to-blue-500 tracking-tight text-base font-bold">
          Promise
        </span>
      </a>
    </div>

    <div class="w-full bg-blue-50 px-4 py-6 rounded-lg mt-6 shadow">
      <p class="text-primary font-bold mb-4"><%= t '.lead' %></p>
      <ol class="flex flex-col gap-4">
        <% steps.each_with_index do |step, i| %>
          <li class="flex gap-3">
            <span class="flex-none w-6 h-6 mt-0.5 rounded-full bg-blue-500 text-white text-xs font-bold flex items-center justify-center">
              <%= i + 1 %>
            </span>
            <div>
              <p class="text-sm text-primary font-bold"><%= step[:title] %></p>
              <p class="text-sm text-secondary mt-0.5"><%= step[:body] %></p>
            </div>
          </li>
        <% end %>
      </ol>

      <%# Privacy reassurance, divided off and centered at the bottom of the box. %>
      <div class="border-t border-blue-200 mt-4 pt-4 text-center text-xs text-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="inline-block align-middle w-4 h-4 mr-1.5 text-blue-500">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg><%= privacy %>
      </div>
    </div>

    <% if type == 'email' %>
      <details class="w-full mt-3 text-sm">
        <summary class="cursor-pointer text-blue-900 hover:text-blue-950 font-medium list-none flex items-center gap-2 [&::-webkit-details-marker]:hidden">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
          </svg>
          <%= t 'registrations.new.child_account_question' %>
        </summary>
        <p class="mt-2 text-sm text-secondary pl-7"><%= t 'registrations.new.child_account_help_html' %></p>
      </details>
    <% end %>

    <div class="mt-6 flex w-full flex-row justify-between items-center">
      <%= link_to t('.back'), login_path(login_configuration),
            class: 'text-sm text-secondary underline hover:text-primary' %>
      <%= link_to login_path(login_configuration.merge(type: type, step: 'form')),
            class: 'button primary appearance-none flex items-center justify-center' do %>
        <%= t '.continue' %><%= arrow_right %>
      <% end %>
    </div>
  </div>
<% end %>
