<%= content_for :header do %>
  <%= image_tag('logo.png', class: 'h-4 m-3') %>
  <h1 class="">
    <%= name %>
  </h1>
<% end %>
<%= content_for :body do %>
  <%= form_tag reset_password_path(login_configuration), class: 'w-full' do %>
    <div class="w-full flex items-center flex-col">
      <h2 class="text-2xl pt-8">
        <%= t '.header' %>
      </h2>
      <p class="text-secondary text-sm max-w-xs text-center mt-4">
        <%= t '.description', name: name %>
      </p>
      <% if flash[:error] %>
        <p class="w-full mt-4 bg-red-500 text-white text-sm p-3 rounded">
          <%= flash[:error] %>
        </p>
      <% end %>
      <label class="mt-4 w-full">
        <p class="input-label">
          <%= t '.new_password' %>
        </p>
        <div class="password-field-wrapper relative">
          <%= password_field_tag :new_password, nil, class: "login-input pr-10", autofocus: true, required: true %>
          <%= render 'shared/password_toggle' %>
        </div>
      </label>
      <div class="flex w-full justify-end items-center mt-6">
        <%= button_tag type: 'submit', class: 'button primary self-end' do %>
          <%= t('.go_on') %><%= arrow_right %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
