<%= content_for :header do %>
  <%= image_tag('logo.png', class: 'h-4 m-3') %>
  <h1 class="">
    <%= name %>
  </h1>
<% end %>
<%= content_for :body do %>
  <%= form_tag recover_code_password_path(login_configuration), class: 'w-full' do %>
    <div class="w-full flex items-center flex-col">
      <h2 class="text-2xl pt-8">
        <%= t '.header' %>
      </h2>
      <p class="text-secondary text-sm max-w-xs text-center mt-4">
        <%= t '.description', phone: @identifier.display_value %>
      </p>
      <% if flash[:error] %>
        <p class="w-full mt-4 bg-red-500 text-white text-sm p-3 rounded">
          <%= flash[:error] %>
        </p>
      <% end %>
      <label class="mt-4 w-full">
        <p class="input-label">
          <%= t '.code' %>
        </p>
        <%= text_field_tag :verification_code, nil, autocomplete: 'one-time-code', inputmode: 'text', autofocus: true, required: true, class: "login-input", data: { "1p-ignore": true, lpignore: true } %>
        <p class="text-secondary text-xs mt-1">
          <%= t '.caps_or_not' %>
        </p>
      </label>
      <div class="flex w-full justify-between items-center mt-6">
        <%= back_to(login_configuration) do |args| new_password_path(args) end %>
        <%= button_tag type: 'submit', class: 'button primary self-end' do %>
          <%= t('.go_on') %><%= arrow_right %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
