<%= content_for :header do %>
  <%= image_tag('logo.png', class: 'h-4 m-3') %>
  <h1 class="">
    <%= name %>
  </h1>
<% end %>
<%= content_for :body do %>
  <%= form_tag recover_password_path(login_configuration), class: 'w-full' do %>
    <div class="w-full flex items-center flex-col">
      <h2 class="text-2xl pt-8">
        <%= t '.header' %>
      </h2>
      <p class="text-secondary text-sm max-w-xs text-center mt-4">
        <%= t '.description', name: name %>
      </p>

      <div class="w-full flex flex-row mt-6 -mb-px" role="tablist">
        <button type="button" id="tab-email" onclick="selectRecovery('email')" class="flex-1 py-2 text-center text-sm font-bold border-b-2 border-blue-700 text-blue-900">
          <%= t '.tab_email' %>
        </button>
        <button type="button" id="tab-phone" onclick="selectRecovery('phone')" class="flex-1 py-2 text-center text-sm border-b-2 border-transparent text-secondary">
          <%= t '.tab_phone' %>
        </button>
      </div>

      <label id="panel-email" class="mt-4 w-full block">
        <p class="input-label">
          <%= t '.email' %>
        </p>
        <%= email_field_tag :email, registration_configuration[:email], id: 'email', class: "login-input", autofocus: true %>
      </label>

      <label id="panel-phone" class="mt-4 w-full hidden">
        <p class="input-label">
          <%= t '.phone' %>
        </p>
        <%= telephone_field_tag :phone, registration_configuration[:phone], id: 'phone', class: "login-input", autocomplete: 'tel', disabled: true %>
      </label>

      <div class="mt-4">
        <%= turnstile_tag_html %>
      </div>
      <div class="flex w-full justify-end items-center mt-6">
        <%= back_to(registration_configuration) do |args| login_path(args) end %>
        <%= button_tag type: 'submit', class: 'button primary self-end' do %>
          <%= t('.go_on') %><%= arrow_right %>
        <% end %>
      </div>
    </div>
  <% end %>

  <script>
    function selectRecovery(type) {
      var isPhone = type === 'phone';
      document.getElementById('panel-email').classList.toggle('hidden', isPhone);
      document.getElementById('panel-phone').classList.toggle('hidden', !isPhone);
      document.getElementById('email').disabled = isPhone;
      document.getElementById('phone').disabled = !isPhone;

      var emailTab = document.getElementById('tab-email');
      var phoneTab = document.getElementById('tab-phone');
      emailTab.classList.toggle('font-bold', !isPhone);
      emailTab.classList.toggle('border-blue-700', !isPhone);
      emailTab.classList.toggle('text-blue-900', !isPhone);
      emailTab.classList.toggle('border-transparent', isPhone);
      emailTab.classList.toggle('text-secondary', isPhone);
      phoneTab.classList.toggle('font-bold', isPhone);
      phoneTab.classList.toggle('border-blue-700', isPhone);
      phoneTab.classList.toggle('text-blue-900', isPhone);
      phoneTab.classList.toggle('border-transparent', !isPhone);
      phoneTab.classList.toggle('text-secondary', !isPhone);

      (isPhone ? document.getElementById('phone') : document.getElementById('email')).focus();
    }
  </script>
<% end %>
